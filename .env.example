# PostgreSQL Database URL (Neon.tech Serverless Postgres)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Chuỗi kết nối TRỰC TIẾP (host không có "-pooler") dùng riêng cho prisma migrate trên Vercel Production.
# Để trống khi chạy local với PostgreSQL thường.
DIRECT_URL=""

# Google AI Studio Gemini API Key
GEMINI_API_KEY=""
GEMINI_SCRAPE_KEYS=""

# Email Configuration (Nodemailer SMTP - Gmail hoặc SMTP tùy chọn)
# Để nhận email thật:
# 1. Bật 2FA trong Google Account
# 2. Tạo App Password tại https://myaccount.google.com/apppasswords
# 3. Điền email vào SMTP_USER và mật khẩu 16 ký tự vào SMTP_PASS
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ChillBanana <support@chillbanana.vn>"

# Email nhận thông báo đơn hàng mới cho Ban Quản Trị (hỗ trợ nhiều email ngăn cách bằng dấu phẩy, để trống nếu không dùng)
ADMIN_NOTIFY_EMAIL=""

# Pricing is stored as versioned PricingConfig records and edited from the Super Admin portal.

# Môi trường chạy: development | demo | staging | production (production từ chối seed và db push)
APP_ENV="development"

# Cờ kích hoạt tự phục hồi tài khoản admin: CHỈ BẬT true TRÊN MÔI TRƯỜNG DEMO (khi APP_ENV="demo").
# TUYỆT ĐỐI KHÔNG BẬT trên production hoặc staging. Mặc định: false
ENABLE_DEMO_SELF_HEAL="false"

# Admin & Customer Session Secrets (generate with: openssl rand -hex 32)
# Dùng để KÝ cookie phiên. Mật khẩu admin/khách được băm bằng scrypt có salt riêng.
ADMIN_SESSION_SECRET=""
CUSTOMER_SESSION_SECRET=""

# Mật khẩu khởi tạo admin khi chạy seed hoặc demo self-heal (tối thiểu 6 ký tự).
# Bắt buộc khi chạy seed trên dev/demo. TUYỆT ĐỐI KHÔNG ĐẶT biến này trên Vercel Production.
ADMIN_INITIAL_PASSWORD=""

# Secret cho cron job báo cáo AI (tối thiểu 32 ký tự ngẫu nhiên)
CRON_SECRET=""

# VNPAY Payment Gateway (Sandbox)
# Safe default is local simulation. Set sandbox explicitly only for a test merchant account.
PAYMENT_MODE="mock" # mock | sandbox; "live" is always blocked in this project
PAYMENT_MOCK_SECRET="" # Optional dedicated HMAC key; defaults to CUSTOMER_SESSION_SECRET
# Tự động tất toán cọc và chuyển đơn sang PURCHASING_JP sau khi thanh toán mô phỏng/sandbox thành công (bật true cho demo)
PAYMENT_AUTO_CONFIRM_ORDER="true"
EMAIL_MODE="mock" # mock | smtp; SMTP sends only when smtp is explicitly selected
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Với môi trường sandbox, cấu hình IPN URL này trong Merchant Admin của tài khoản test:
# https://<domain-công-khai>/api/payment/vnpay-ipn

# ==============================================================================
# Gemini Model Chains (Cấu hình chuỗi model phân tách bằng dấu phẩy)
# - Cấu hình Development (Mặc định - Ưu tiên Flash-Lite vì hạn mức 15 RPM / 500 RPD, Flash dự phòng khi cần suy luận sâu):
#   GEMINI_CHAT_MODELS="gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash"
#   GEMINI_LIGHT_MODELS="gemini-3.5-flash-lite,gemini-3.1-flash-lite"
#   GEMINI_VISION_MODELS="gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash"
#   GEMINI_ADMIN_MODELS="gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite"
#   GEMINI_INSPECT_MODELS="gemini-3.5-flash-lite,gemini-3.8-flash"
# - Cấu hình Demo / Chất lượng cao (Ưu tiên Flash 3.8 cho chất lượng văn phong và suy luận cao nhất):
#   GEMINI_CHAT_MODELS="gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite"
# ==============================================================================
GEMINI_CHAT_MODELS=""
GEMINI_LIGHT_MODELS=""
GEMINI_VISION_MODELS=""
GEMINI_ADMIN_MODELS=""
GEMINI_INSPECT_MODELS=""

# ==============================================================================
# External Ecommerce APIs (Rakuten Ichiba & Yahoo! Shopping - WP4.2)
