{
  "name": "chillbanana",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "node scripts/vercel-build.js",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "node scripts/guard-db-push.js",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:seed": "prisma db seed",
    "eval:customer-support": "node scripts/evals/customer-support-evals.cjs",
    "eval:support": "node scripts/evals/customer-support-evals.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:integration && npm run test:e2e",
    "bundle:ai": "node scripts/export-codebase.mjs",
    "bundle:extra": "node scripts/export-supplementary.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },


  "overrides": {
    "next": {
      "postcss": "8.5.30"
    },
    "source-map-js": "1.2.2"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "lucide-react": "^0.453.0",
    "next": "15.5.27",
    "nodemailer": "10.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.27",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true
  }
}
