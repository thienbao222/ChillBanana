// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 7 Trạng thái đơn hàng chuẩn mua hộ Nhật - Việt
// PENDING_DEPOSIT: Chờ cọc (50% hoặc 100%)
// PURCHASING_JP: Đã nhận cọc - Nhân viên tại Nhật đang mua hàng
// WAREHOUSE_JP: Đã nhập kho Tokyo/Osaka (Kiểm tra & Cân đo)
// IN_TRANSIT_AIR: Đang bay quốc tế Nhật -> Việt Nam (Narita -> Nội Bài/Tân Sơn Nhất)
// WAREHOUSE_VN: Đã cập cảng / nhập kho phân loại tại Việt Nam
// LOCAL_DELIVERY: Đang giao hàng chặng cuối (GHTK/GHN/ViettelPost)
// COMPLETED: Giao hàng thành công

model Order {
  id               String        @id @default(cuid())
  orderCode        String        @unique // Ví dụ: KZN-2026-8921
  customerName     String
  customerEmail    String
  customerPhone    String
  customerAddress  String

  // Phân loại khách hàng (REGISTERED | GUEST)
  customerId       String?
  customer         Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerType     String       @default("GUEST")

  // Thông tin sản phẩm mua hộ
  originalUrl      String?       // Link từ Amazon JP, Mercari, Rakuten...
  productName      String
  category         String        // cosmetics, health, gadgets, anime, other
  priceJpy         Int           // Giá gốc bằng Yên Nhật
  weightKg         Float         // Trọng lượng ước tính/thực tế (kg)

  // Chi phí chi tiết (VND)
  exchangeRate     Int           @default(172) // 1 JPY = X VND
  productPriceVnd  Int           // Giá hàng quy đổi VND
  serviceFeeVnd    Int           // Phí mua hộ (3% - 5%)
  shippingFeeVnd   Int           // Cước bay quốc tế (185.000đ/kg)
  totalVnd         Int           // Tổng giá trị đơn hàng
  depositAmountVnd Int           // Số tiền đã thanh toán/đặt cọc
  depositPercent   Int           @default(50) // 50 hoặc 100; áp dụng cho tiền hàng + phí mua hộ
  paymentStatus    String        @default("UNPAID") // UNPAID, DEPOSITED_50, PAID_100, REFUNDED
  paymentMethod    String        @default("VIETQR") // VIETQR, VNPAY, MOMO, COD

  // Tùy chọn gộp đơn
  isGroupBuy       Boolean       @default(false)
  groupBuyCode     String?       // Mã gom đơn chung

  // Trạng thái & Tracking
  status           String        @default("PENDING_DEPOSIT")
  jpDomesticTrack  String?       // Mã vận đơn nội địa Nhật (Sagawa/Yamato)
  vnDomesticTrack  String?       // Mã vận đơn nội địa VN (GHTK/GHN)
  adminNote        String?
  customerNote     String?

  // Trạng thái báo giá cho đơn hàng ngoài catalog
  isPriceVerified  Boolean       @default(false)
  priceVerifiedAt  DateTime?

  trackingLogs     TrackingLog[]
  orderItems       OrderItem[]
  paymentTransactions PaymentTransaction[]
  purchaseTask     PurchaseTask?         // Nhóm 3: Auto-Purchasing Agent task
  reservationExpiresAt DateTime?
  reservationReleasedAt DateTime?
  pricingConfigVersion Int?
  pricingConfig PricingConfig? @relation(fields: [pricingConfigVersion], references: [version], onDelete: SetNull)
  paymentAttempts PaymentAttempt[]
  emailLogs EmailLog[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([customerType])
  @@index([customerId])
  @@index([customerEmail])
  @@index([status, paymentStatus, reservationExpiresAt])
}

model PaymentTransaction {
  id                    String   @id @default(cuid())
  orderId               String
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider              String   // VNPAY | MANUAL_BANK_TRANSFER
  amountVnd             Int
  status                String   @default("CONFIRMED") // CONFIRMED | REFUNDED
  providerTransactionId String?
  reference             String?
  confirmedByAdmin      String?
  confirmedAt           DateTime @default(now())
  createdAt             DateTime @default(now())

  @@unique([provider, providerTransactionId])
  @@index([orderId, createdAt])
}

// Ghi nhận các lần khởi tạo/kết quả thanh toán, bao gồm cả mock thất bại hoặc pending.
model PaymentAttempt {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        String   // MOCK | VNPAY_SANDBOX
  mode            String   // mock | sandbox
  amountVnd       Int
  status          String   @default("INITIATED") // INITIATED | PENDING | FAILED | CONFIRMED (sandbox/mock result) | EXPIRED
  idempotencyKey  String   @unique
  providerReference String?
  failureCode     String?
  expiresAt       DateTime
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orderId, createdAt])
  @@index([status, expiresAt])
}

// Versioned business pricing snapshot; changing config appends a record instead of overwriting history.
model PricingConfig {
  version       Int      @id @default(autoincrement())
  values        Json
  changedBy     String
  changeReason  String?
  createdAt     DateTime @default(now())
  orders        Order[]

  @@index([createdAt])
}

// Email outbox/audit metadata. Message bodies and bearer links are intentionally not persisted.
model EmailLog {
  id             String   @id @default(cuid())
  orderId        String?
  order          Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  emailType      String
  payload        Json?
  providerMode   String   // mock | smtp
  status         String   // SIMULATED | PENDING | SENT | FAILED
  attemptCount   Int      @default(0)
  maxAttempts    Int      @default(3)
  lastErrorCode  String?
  nextRetryAt    DateTime?
  lastAttemptAt  DateTime?
  sentAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, nextRetryAt])
  @@index([orderId, createdAt])
}

// Dòng chi tiết từng sản phẩm trong đơn — cho phép hoàn kho khi hủy đơn
model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Nếu là catalog item, lưu productId để có thể hoàn kho
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  itemType      String   // "CATALOG" | "EXTERNAL"
  productName   String   // Tên tại thời điểm đặt hàng (snapshot)
  quantity      Int
  priceJpy      Int      // Đơn giá ¥ mỗi item (server-verified cho catalog)
  weightKg      Float    // Cân nặng mỗi item (kg)

  createdAt     DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model TrackingLog {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      String   // Mã trạng thái tại thời điểm log
  title       String   // Tiêu đề ngắn gọn (VD: Đã nhập kho Tokyo)
  description String   // Chi tiết (VD: Kiện hàng đã được cân đo 0.85kg và đóng gói chuẩn bay)
  location    String   // Tokyo, Osaka, Narita Airport, Hà Nội, TP.HCM...
  createdAt   DateTime @default(now())
}

// 4 Danh mục chủ lực tinh gọn
model Product {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  category       String   // cosmetics, health, gadgets, anime
  categoryName   String   // Mỹ phẩm, Thực phẩm chức năng, Đồ gia dụng mini, Anime Figure
  priceJpy       Int      // Giá gốc JPY
  priceVnd       Int      // Giá ước tính VND
  weightKg       Float    // Cân nặng ước tính (kg)
  imageUrl       String
  description    String
  originalStore  String   // Amazon JP, Mercari JP, Rakuten, Surugaya, Uniqlo JP
  stockSlots     Int      @default(10) // Số lượng suất mua hộ / slot còn lại
  isHot          Boolean  @default(false)
  featuredNote   String?  // Ghi chú đặc biệt (VD: Bán chạy số 1 tại Cosme Nhật)
  voltageNote    String?  // Cảnh báo điện áp nếu là đồ điện tử (VD: "Điện áp 100V - Cần dùng biến áp")
  orderItems     OrderItem[]
  createdAt      DateTime @default(now())
}

// Góc Bản tin & Văn hóa Kizuna (Kizuna News Corner)
model News {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  category    String   // MeoSangSale, LichBay, KienThucNhat, Review
  categoryName String
  excerpt     String   // Tóm tắt ngắn
  content     String   // Nội dung bài viết
  coverImage  String
  readTime    String   @default("3 phút đọc")
  publishedAt DateTime @default(now())
}

// Quản trị viên hệ thống (Admin Authentication)
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String   @default("Quản Trị Viên ChillBanana")
  role         String   @default("SUPER_ADMIN") // SUPER_ADMIN, OPERATOR
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Lưu báo cáo insight theo ngày nghiệp vụ Việt Nam để cron và Admin cùng đọc một nguồn.
model AdminDailyInsight {
  id              String   @id @default(cuid())
  businessDate    String   @unique
  periodStart     DateTime
  periodEnd       DateTime
  generatedAt     DateTime
  insight         String
  snapshotSummary Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([generatedAt])
}

// Lịch sử Chat AI Consultant & Phân tích xu hướng khách hàng
model ChatSession {
  id               String        @id @default(cuid())
  sessionId        String        @unique
  personality      String        @default("omotenashi") // omotenashi (Nhật) hoặc vietnamese (Thân thiện)
  topic            String?       // Chủ đề chính (Mỹ phẩm, Thực phẩm chức năng, Gundam/Mô hình, Đồ điện tử, Vận chuyển...)
  detectedKeywords String?       // Từ khóa khách hỏi: gundam, son dưỡng, nồi cơm 100V, cước bay...
  sentiment        String?       // positive, inquiry, complaint
  userIp           String?       // IP hoặc thiết bị khách hàng
  // Phân loại & Định danh khách hàng trong Chat
  customerType     String       @default("ANONYMOUS_GUEST") // "REGISTERED" | "GUEST_ORDER" | "ANONYMOUS_GUEST"
  customerId       String?
  customer         Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName     String?
  customerEmail    String?
  customerPhone    String?
  messages         ChatMessage[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([customerType])
  @@index([createdAt])
  @@index([customerId])
}

model ChatMessage {
  id            String      @id @default(cuid())
  sessionId     String
  chatSession   ChatSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  role          String      // "user" | "assistant" | "system"
  content       String
  categoryTag   String?     // Tag phân loại sản phẩm / nhu cầu
  createdAt     DateTime    @default(now())
}

// Khách hàng đăng ký tài khoản (Customer Authentication & Profile)
model Customer {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  address      String?
  emailVerifiedAt DateTime?
  zaloUserId   String?   // Zalo OA User ID — lưu khi khách Follow OA (để gửi thông báo Zalo)
  orders       Order[]
  chatSessions ChatSession[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ─── Nhóm 3: Auto-Purchasing Agent (Phase A — API-first, human-in-the-loop) ──

// Task mua hộ — được tạo sau khi khách đã cọc đủ và Admin muốn kích hoạt mua tự động
// Phase A: Chỉ hỗ trợ Amazon JP (link deep) và Rakuten (API tìm sản phẩm)
// Phase B: Mercari/Yahoo (Playwright) — chưa triển khai
model PurchaseTask {
  id              String    @id @default(cuid())
  orderId         String    @unique
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Platform nguồn (phát hiện tự động từ originalUrl của Order)
  platform        String    // "amazon_jp" | "rakuten" | "mercari" | "yahoo_jp" | "unknown"

  // Trạng thái task
  // QUEUED: Chờ Admin duyệt
  // APPROVED: Admin đã duyệt, sẵn sàng để nhân viên JP thực hiện
  // IN_PROGRESS: Đang tiến hành mua (nhân viên JP xác nhận)
  // PURCHASED: Đã mua thành công — có externalOrderId
  // FAILED: Mua thất bại (hết hàng, lỗi thanh toán...)
  // CANCELLED: Admin hủy task
  status          String    @default("QUEUED")

  // Thông tin tìm kiếm / tra cứu từ platform
  externalProductId String? // ASIN (Amazon) hoặc Item Code (Rakuten)
  externalOrderId   String? // Mã đơn tại sàn nguồn (sau khi mua thành công)
  platformUrl       String? // URL xác nhận / deeplink để nhân viên JP mua

  // Thông tin báo giá từ platform (snapshot tại thời điểm tạo task)
  scrapedPriceJpy Int?      // Giá thực tế lấy từ platform (so sánh với priceJpy của Order)
  priceDiffPercent Float?   // Chênh lệch giá (nếu > 5% → cảnh báo)

  // Audit trail
  createdByAdmin  String?   // Username Admin tạo task
  approvedByAdmin String?   // Username Admin duyệt (bắt buộc trước khi IN_PROGRESS)
  approvedAt      DateTime?
  purchasedByStaff String?  // Nhân viên JP xác nhận đã mua
  purchasedAt     DateTime?

  attempts        Int       @default(0)
  lastError       String?
  adminNote       String?   // Ghi chú nội bộ

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([platform])
  @@index([createdAt])
}

// ─── Giai đoạn 1: An toàn dữ liệu ───────────────────────────────────────────

// Bộ đếm giới hạn tần suất (đăng nhập sai, đăng ký...) lưu bền trong database.
model RateLimit {
  key          String    @id // ví dụ: admin-login:user:admin, admin-login:ip:1.2.3.4
  count        Int
  windowStart  DateTime
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([updatedAt])
}

// Nhật ký kiểm toán các thao tác nhạy cảm (không lưu mật khẩu/token trong summary hoặc metadata).
model AuditLog {
  id         String   @id @default(cuid())
  actor      String   // username admin, email khách hoặc "system"
  actorType  String   @default("ADMIN") // ADMIN, CUSTOMER, SYSTEM
  action     String   // ADMIN_LOGIN, PRODUCT_UPDATE, ORDER_PAYMENT_RECORDED...
  entityType String?
  entityId   String?
  summary    String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actor, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
}
