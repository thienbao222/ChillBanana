// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 7 Trạng thái đơn hàng chuẩn mua hộ Nhật - Việt
// PENDING_DEPOSIT: Chờ cọc (50% hoặc 100%)
// PURCHASING_JP: Đã nhận cọc - Nhân viên tại Nhật đang mua hàng
// WAREHOUSE_JP: Đã nhập kho Tokyo/Osaka (Kiểm tra & Cân đo)
// IN_TRANSIT_AIR: Đang bay quốc tế Nhật -> Việt Nam (Narita -> Nội Bài/Tân Sơn Nhất)
// WAREHOUSE_VN: Đã cập cảng / nhập kho phân loại tại Việt Nam
// LOCAL_DELIVERY: Đang giao hàng chặng cuối (GHTK/GHN/ViettelPost)
// COMPLETED: Giao hàng thành công

model Order {
  id               String        @id @default(cuid())
  orderCode        String        @unique // Ví dụ: KZN-2026-8921
  customerName     String
  customerEmail    String
  customerPhone    String
  customerAddress  String

  // Phân loại khách hàng (REGISTERED | GUEST)
  customerId       String?
  customer         Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerType     String       @default("GUEST")

  // Thông tin sản phẩm mua hộ
  originalUrl      String?       // Link từ Amazon JP, Mercari, Rakuten...
  productName      String
  category         String        // cosmetics, health, gadgets, anime, other
  priceJpy         Int           // Giá gốc bằng Yên Nhật
  weightKg         Float         // Trọng lượng ước tính/thực tế (kg)

  // Chi phí chi tiết (VND)
  exchangeRate     Int           @default(172) // 1 JPY = X VND
  productPriceVnd  Int           // Giá hàng quy đổi VND
  serviceFeeVnd    Int           // Phí mua hộ (3% - 5%)
  handlingFeeVnd   Int?          @default(0) // Phí xử lý cố định (WP3.2)
  fxFeeVnd         Int?          @default(0) // Phí chuyển đổi ngoại tệ (WP3.2)
  shippingFeeVnd   Int           // Cước bay quốc tế (185.000đ/kg)
  taxEstimateVnd   Int?          @default(0) // Thuế ước tính (WP3.2)
  totalVnd         Int           // Tổng giá trị đơn hàng
  depositAmountVnd Int           // Số tiền đã thanh toán/đặt cọc
  depositPercent   Int           @default(50) // 50 hoặc 100; áp dụng cho tiền hàng + phí mua hộ
  paymentStatus    String        @default("UNPAID") // UNPAID, DEPOSITED_50, PAID_100, REFUNDED
  paymentMethod    String        @default("VIETQR") // VIETQR, VNPAY, MOMO, COD
  fulfillmentOrigin String       @default("JP") // "JP" (Kho Tokyo/Mua hộ Nhật) | "VN" (Có sẵn tại kho Việt Nam)

  // Tùy chọn gộp đơn
  isGroupBuy       Boolean       @default(false)
  groupBuyCode     String?       // Mã gom đơn chung

  // Trạng thái & Tracking
  status           String        @default("PENDING_DEPOSIT")
  jpDomesticTrack  String?       // Mã vận đơn nội địa Nhật (Sagawa/Yamato)
  vnDomesticTrack  String?       // Mã vận đơn nội địa VN (GHTK/GHN)
  adminNote        String?
  customerNote     String?

  // Trạng thái báo giá cho đơn hàng ngoài catalog
  isPriceVerified  Boolean       @default(false)
  priceVerifiedAt  DateTime?

  trackingLogs     TrackingLog[]
  orderItems       OrderItem[]
  paymentTransactions PaymentTransaction[]
  costLines        OrderCostLine[]
  purchaseTask     PurchaseTask?         // Nhóm 3: Auto-Purchasing Agent task
  reservationExpiresAt DateTime?
  quoteHoldExpiresAt   DateTime?
  reservationReleasedAt DateTime?
  belowMargin          Boolean?      @default(false)
  pricingConfigVersion Int?
  pricingConfig PricingConfig? @relation(fields: [pricingConfigVersion], references: [version], onDelete: SetNull)
  paymentAttempts PaymentAttempt[]
  emailLogs EmailLog[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([customerType])
  @@index([customerId])
  @@index([customerEmail])
  @@index([status, paymentStatus, reservationExpiresAt])
  @@index([status, paymentStatus, quoteHoldExpiresAt])
}

model PaymentTransaction {
  id                    String              @id @default(cuid())
  orderId               String
  order                 Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider              String              // VNPAY | MANUAL_BANK_TRANSFER
  amountVnd             Int
  status                String              @default("CONFIRMED") // CONFIRMED | REFUNDED | VOIDED
  kind                  String              @default("LEGACY")    // DEPOSIT | BALANCE | REFUND | REVERSAL | LEGACY
  reversalOfId          String?
  reversalOf            PaymentTransaction? @relation("PaymentReversals", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals             PaymentTransaction[] @relation("PaymentReversals")
  voidedAt              DateTime?
  note                  String?
  shipmentId            String?             // Dành cho WP6.1 (VN -> JP)
  providerTransactionId String?
  reference             String?
  confirmedByAdmin      String?
  confirmedAt           DateTime            @default(now())
  createdAt             DateTime            @default(now())

  @@unique([provider, providerTransactionId])
  @@index([orderId, createdAt])
  @@index([kind])
  @@index([reversalOfId])
  @@index([shipmentId])
}

// Ghi nhận các lần khởi tạo/kết quả thanh toán, bao gồm cả mock thất bại hoặc pending.
model PaymentAttempt {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        String   // MOCK | VNPAY_SANDBOX
  mode            String   // mock | sandbox
  amountVnd       Int
  status          String   @default("INITIATED") // INITIATED | PENDING | FAILED | CONFIRMED (sandbox/mock result) | EXPIRED
  idempotencyKey  String   @unique
  providerReference String?
  failureCode     String?
  expiresAt       DateTime
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orderId, createdAt])
  @@index([status, expiresAt])
}

// Versioned business pricing snapshot; changing config appends a record instead of overwriting history.
model PricingConfig {
  version       Int      @id @default(autoincrement())
  values        Json
  changedBy     String
  changeReason  String?
  createdAt     DateTime @default(now())
  orders        Order[]

  @@index([createdAt])
}

// Email outbox/audit metadata. Message bodies and bearer links are intentionally not persisted.
model EmailLog {
  id             String   @id @default(cuid())
  orderId        String?
  order          Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  emailType      String
  payload        Json?
  providerMode   String   // mock | smtp
  status         String   // SIMULATED | PENDING | SENT | FAILED
  attemptCount   Int      @default(0)
  maxAttempts    Int      @default(3)
  lastErrorCode  String?
  nextRetryAt    DateTime?
  lastAttemptAt  DateTime?
  sentAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, nextRetryAt])
  @@index([orderId, createdAt])
}

// Dòng chi tiết từng sản phẩm trong đơn — cho phép hoàn kho khi hủy đơn
model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Nếu là catalog item, lưu productId để có thể hoàn kho
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  itemType      String   // "CATALOG" | "EXTERNAL"
  productName   String   // Tên tại thời điểm đặt hàng (snapshot)
  quantity      Int
  priceJpy      Int      // Đơn giá ¥ mỗi item (server-verified cho catalog)
  weightKg      Float    // Cân nặng mỗi item (kg)

  // Nguồn báo giá & duyệt giá (WP4.1)
  quoteSource     String?  // CATALOG | API_RAKUTEN | API_YAHOO | EXTENSION | MANUAL | SCRAPE
  quoteVerifiedAt DateTime?
  quoteVerifiedBy String?

  // Chiến dịch mua theo đợt (WP5.1)
  campaignEntry   CampaignEntry?

  createdAt     DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model TrackingLog {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      String   // Mã trạng thái tại thời điểm log
  title       String   // Tiêu đề ngắn gọn (VD: Đã nhập kho Tokyo)
  description String   // Chi tiết (VD: Kiện hàng đã được cân đo 0.85kg và đóng gói chuẩn bay)
  location    String   // Tokyo, Osaka, Narita Airport, Hà Nội, TP.HCM...
  createdAt   DateTime @default(now())
}

// 4 Danh mục chủ lực tinh gọn
model Product {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  category       String   // cosmetics, health, gadgets, anime
  categoryName   String   // Mỹ phẩm, Thực phẩm chức năng, Đồ gia dụng mini, Anime Figure
  priceJpy       Int      // Giá gốc JPY
  priceVnd       Int      // Giá ước tính VND
  weightKg       Float    // Cân nặng ước tính (kg)
  imageUrl       String
  description    String
  originalStore  String   // Amazon JP, Mercari JP, Rakuten, Surugaya, Uniqlo JP
  stockSlots     Int      @default(10) // Số lượng suất mua hộ / slot còn lại
  isHot          Boolean  @default(false)
  featuredNote   String?  // Ghi chú đặc biệt (VD: Bán chạy số 1 tại Cosme Nhật)
  voltageNote    String?  // Cảnh báo điện áp nếu là đồ điện tử (VD: "Điện áp 100V - Cần dùng biến áp")
  fulfillmentOrigin String @default("JP") // "JP" (Kho Tokyo/Mua hộ Nhật) | "VN" (Có sẵn tại kho Việt Nam)
  orderItems     OrderItem[]
  createdAt      DateTime @default(now())
}

// Góc Bản tin & Văn hóa Kizuna (Kizuna News Corner)
model News {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  category    String   // MeoSangSale, LichBay, KienThucNhat, Review
  categoryName String
  excerpt     String   // Tóm tắt ngắn
  content     String   // Nội dung bài viết
  coverImage  String
  readTime    String   @default("3 phút đọc")
  publishedAt DateTime @default(now())
}

// Quản trị viên hệ thống (Admin Authentication)
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String   @default("Quản Trị Viên ChillBanana")
  role         String   @default("SUPER_ADMIN") // SUPER_ADMIN, OPERATOR
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Lưu báo cáo insight theo ngày nghiệp vụ Việt Nam để cron và Admin cùng đọc một nguồn.
model AdminDailyInsight {
  id              String   @id @default(cuid())
  businessDate    String   @unique
  periodStart     DateTime
  periodEnd       DateTime
  generatedAt     DateTime
  insight         String
  snapshotSummary Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([generatedAt])
}

// Lịch sử Chat AI Consultant & Phân tích xu hướng khách hàng
model ChatSession {
  id               String        @id @default(cuid())
  sessionId        String        @unique
  personality      String        @default("omotenashi") // omotenashi (Nhật) hoặc vietnamese (Thân thiện)
  topic            String?       // Chủ đề chính (Mỹ phẩm, Thực phẩm chức năng, Gundam/Mô hình, Đồ điện tử, Vận chuyển...)
  detectedKeywords String?       // Từ khóa khách hỏi: gundam, son dưỡng, nồi cơm 100V, cước bay...
  sentiment        String?       // positive, inquiry, complaint
  userIp           String?       // IP hoặc thiết bị khách hàng
  // Phân loại & Định danh khách hàng trong Chat
  customerType     String       @default("ANONYMOUS_GUEST") // "REGISTERED" | "GUEST_ORDER" | "ANONYMOUS_GUEST"
  customerId       String?
  customer         Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName     String?
  customerEmail    String?
  customerPhone    String?
  messages         ChatMessage[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([customerType])
  @@index([createdAt])
  @@index([customerId])
}

model ChatMessage {
  id            String      @id @default(cuid())
  sessionId     String
  chatSession   ChatSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  role          String      // "user" | "assistant" | "system"
  content       String
  categoryTag   String?     // Tag phân loại sản phẩm / nhu cầu
  createdAt     DateTime    @default(now())
}

// Khách hàng đăng ký tài khoản (Customer Authentication & Profile)
model Customer {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  address      String?
  emailVerifiedAt DateTime?
  zaloUserId   String?   // Zalo OA User ID — lưu khi khách Follow OA (để gửi thông báo Zalo)
  orders       Order[]
  chatSessions ChatSession[]
  vnJpShipments VnJpShipment[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ─── Nhóm 3: Auto-Purchasing Agent (Phase A — API-first, human-in-the-loop) ──

// Task mua hộ — được tạo sau khi khách đã cọc đủ và Admin muốn kích hoạt mua tự động
// Phase A: Chỉ hỗ trợ Amazon JP (link deep) và Rakuten (API tìm sản phẩm)
// Phase B: Mercari/Yahoo (Playwright) — chưa triển khai
model PurchaseTask {
  id              String    @id @default(cuid())
  orderId         String    @unique
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Platform nguồn (phát hiện tự động từ originalUrl của Order)
  platform        String    // "amazon_jp" | "rakuten" | "mercari" | "yahoo_jp" | "unknown"

  // Trạng thái task
  // QUEUED: Chờ Admin duyệt
  // APPROVED: Admin đã duyệt, sẵn sàng để nhân viên JP thực hiện
  // IN_PROGRESS: Đang tiến hành mua (nhân viên JP xác nhận)
  // PURCHASED: Đã mua thành công — có externalOrderId
  // FAILED: Mua thất bại (hết hàng, lỗi thanh toán...)
  // CANCELLED: Admin hủy task
  status          String    @default("QUEUED")

  // Thông tin tìm kiếm / tra cứu từ platform
  externalProductId String? // ASIN (Amazon) hoặc Item Code (Rakuten)
  externalOrderId   String? // Mã đơn tại sàn nguồn (sau khi mua thành công)
  platformUrl       String? // URL xác nhận / deeplink để nhân viên JP mua

  // Thông tin báo giá từ platform (snapshot tại thời điểm tạo task)
  scrapedPriceJpy Int?      // Giá thực tế lấy từ platform (so sánh với priceJpy của Order)
  priceDiffPercent Float?   // Chênh lệch giá (nếu > 5% → cảnh báo)

  // Audit trail
  createdByAdmin  String?   // Username Admin tạo task
  approvedByAdmin String?   // Username Admin duyệt (bắt buộc trước khi IN_PROGRESS)
  approvedAt      DateTime?
  purchasedByStaff String?  // Nhân viên JP xác nhận đã mua
  purchasedAt     DateTime?

  attempts        Int       @default(0)
  lastError       String?
  adminNote       String?   // Ghi chú nội bộ

  costLines       OrderCostLine[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([platform])
  @@index([createdAt])
}

// Bảng ghi nhận chi phí thực tế cho đơn hàng (WP2.1)
model OrderCostLine {
  id             String        @id @default(cuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  purchaseTaskId String?
  purchaseTask   PurchaseTask? @relation(fields: [purchaseTaskId], references: [id], onDelete: SetNull)
  category       String        // GOODS_JPY | JP_DOMESTIC_SHIP | TOKYO_HANDLING | INTL_FREIGHT | VN_DOMESTIC_SHIP | IMPORT_TAX | PAYMENT_FEE | FX_FEE | OTHER
  amountOriginal Float
  currency       String        // JPY | VND
  fxRate         Float?
  amountVnd      Int
  note           String?
  receiptUrl     String?
  createdBy      String
  createdAt      DateTime      @default(now())
  voidedAt       DateTime?
  shipmentId     String?       // Dành cho WP6.1 (VN -> JP)

  @@index([orderId, category])
  @@index([category])
  @@index([shipmentId])
  @@index([purchaseTaskId])
}

// Cấu hình hệ thống động — Admin có thể điều chỉnh tỷ lệ phí, cước vận chuyển mà không cần redeploy
model SystemConfig {
  key         String    @id           // Ví dụ: "service_fee_percent", "air_shipping_per_kg_vnd"
  value       String                  // Luôn lưu dạng string, parse khi dùng
  description String?                 // Giải thích ý nghĩa để Admin hiểu
  updatedAt   DateTime  @updatedAt
  updatedBy   String?                 // Username Admin cập nhật gần nhất

  @@map("system_config")
}

// Bộ đếm giới hạn tần suất lưu bền trong database
model RateLimit {
  key          String    @id
  count        Int
  windowStart  DateTime
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([updatedAt])
}

// Nhật ký kiểm toán các thao tác nhạy cảm
model AuditLog {
  id         String   @id @default(cuid())
  actor      String   // username admin, email khách hoặc "system"
  actorType  String   @default("ADMIN") // ADMIN, CUSTOMER, SYSTEM
  action     String   // ADMIN_LOGIN, PRODUCT_UPDATE, ORDER_PAYMENT_RECORDED...
  entityType String?
  entityId   String?
  summary    String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actor, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
}

// =========================================================================
// PHÂN HỆ ĐỘC LẬP: KÝ GỬI & VẬN CHUYỂN HÀNG KHÔNG VIỆT NAM ➔ NHẬT BẢN (VN ➔ JP)
// =========================================================================
model VnJpShipment {
  id                    String   @id @default(cuid())
  trackingCode          String   @unique // Ví dụ: VNJP-2026-8891

  // Khách hàng sở hữu phiếu (WP6.1)
  customerId            String?
  customer              Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Người gửi tại Việt Nam
  senderName            String
  senderPhone           String
  senderAddress         String
  senderCity            String   @default("Hà Nội")
  pickupDate            String?  // Ngày hẹn bưu tá qua lấy hàng tận nơi

  // Người nhận tại Nhật Bản
  receiverName          String   // Tên Romaji in hoa (VD: NGUYEN VAN A)
  receiverPhone         String   // SĐT nội địa Nhật (+81 hoặc 070/080/090)
  receiverPostalCode    String   // Mã bưu điện Nhật Bản 〒 7 số (VD: 160-0022)
  receiverPrefecture    String   // Tỉnh/Thành (Tokyo, Osaka, Kanagawa...)
  receiverAddress       String   // Địa chỉ chi tiết, Tên Mansion, Số phòng

  // Tuân thủ dữ liệu & kiểm dịch MAFF (WP6.1, WP6.2)
  consentAt             DateTime?
  consentVersion        String?
  maffAcknowledgedAt    DateTime?

  // Hàng hóa & Cước tính IATA
  cargoType             String   // gift, food, doc, other
  cargoDetails          String   // Mô tả chi tiết từng món hàng
  estimatedWeightKg     Float    // Cân nặng ước tính ban đầu (kg)
  actualWeightKg        Float?   // Cân nặng thực tế cân tại kho VN (kg)
  dimensionLengthCm     Float?   // Dài (cm)
  dimensionWidthCm      Float?   // Rộng (cm)
  dimensionHeightCm     Float?   // Cao (cm)
  chargeableWeightKg    Float?   // Cân tính cước = Max(Cân thực, D*R*C/5000)
  unitPricePerKg        Int      // Đơn giá cước VNĐ/kg (180.000, 210.000, 220.000, 200.000)
  totalShippingFeeVnd   Int      // Tổng cước VNĐ
  paymentStatus         String   @default("UNPAID") // UNPAID, PAID

  // Cam kết kiểm dịch MAFF Nhật Bản (Chống gửi thịt, xúc xích, hàng cấm)
  maffAgreement         Boolean  @default(true)

  // Vòng đời 5 bước điều phối chuyên biệt:
  // 1. PENDING_CONFIRMATION: Mới tiếp nhận (Chờ gọi điện xác minh)
  // 2. CONFIRMED_PICKUP: Đã gọi xác nhận, hẹn bưu tá qua lấy tại VN
  // 3. WAREHOUSE_VN_INSPECTED: Đã về kho VN, kiểm tra hàng cấm & cân đo IATA
  // 4. IN_FLIGHT_TO_JP: Đang bay sang Nhật (Narita/Haneda/Kansai)
  // 5. DELIVERED_JP: Bưu tá Yamato/Sagawa đã phát tận tay thành công
  // (CANCELLED: Hủy đơn nếu khách gửi đồ cấm hoặc từ chối)
  status                String   @default("PENDING_CONFIRMATION")

  // Thông tin tác nghiệp điều phối viên
  dispatcherNote        String?  // Ghi chú cuộc gọi của nhân viên
  flightNumber          String?  // Số hiệu chuyến bay (VD: VN310, JL752)
  japanCourier          String?  @default("Yamato Transport") // Yamato Transport, Sagawa, Japan Post
  japanTrackingCode     String?  // Mã vận đơn nội địa Nhật

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([status])
  @@index([trackingCode])
  @@index([senderPhone])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// CHIẾN DỊCH MUA THEO ĐỢT (GROUP BUY / CAMPAIGNS - WP5.1)
// ─────────────────────────────────────────────────────────────────────────────

model Campaign {
  id              String         @id @default(cuid())
  slug            String         @unique
  title           String
  description     String?
  marketplace     String         // RAKUTEN | YAHOO | AMAZON | OTHER
  status          String         @default("DRAFT") // DRAFT, OPEN, CLOSED, ORDERED, ARRIVED, SHIPPED, SETTLED, CANCELLED
  opensAt         DateTime?
  closesAt        DateTime?
  minParticipants Int            @default(1)
  maxSlots        Int?           // Tổng giới hạn suất của chiến dịch
  notes           String?
  createdBy       String?

  campaignItems   CampaignItem[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([slug])
  @@index([closesAt])
}

model CampaignItem {
  id           String          @id @default(cuid())
  campaignId   String
  campaign     Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name         String
  priceJpy     Int
  weightKg     Float
  maxSlots     Int?
  claimedSlots Int             @default(0)
  imageUrl     String?
  originalUrl  String?

  entries      CampaignEntry[]

  createdAt    DateTime        @default(now())

  @@index([campaignId])
}

model CampaignEntry {
  id             String        @id @default(cuid())
  campaignItemId String
  campaignItem   CampaignItem  @relation(fields: [campaignItemId], references: [id], onDelete: Cascade)

  orderItemId    String?       @unique
  orderItem      OrderItem?    @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  quantity       Int           @default(1)
  createdAt      DateTime      @default(now())

  @@index([campaignItemId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ĐÓNG SỔ KỲ KẾ TOÁN (PERIOD CLOSE - WP7.2)
// ─────────────────────────────────────────────────────────────────────────────

model PeriodClose {
  id              String   @id @default(cuid())
  period          String   @unique // Ví dụ: "2026-10", "2026-11"
  closedAt        DateTime @default(now())
  closedBy        String   // Username Super Admin
  totalGmvVnd     BigInt   @default(0)
  totalRevenueVnd BigInt   @default(0)
  totalCostVnd    BigInt   @default(0)
  grossProfitVnd  BigInt   @default(0)
  ordersCount     Int      @default(0)
  notes           String?
  createdAt       DateTime @default(now())

  @@index([period])
}



